            ]
          },
          {
            "group": "Building",
            "pages": [
              "studio",
              "agent-models",
              "services",
              "import"
            ]
          },
          {
            "group": "Shipping",
            "pages": [
              "deployments",
              "marketplace"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "plans-and-credits",
              "collaboration"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "href": "https://iqx.dev/dashboard?view=community"
      },
      {
