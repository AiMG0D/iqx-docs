{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "IQX Docs",
  "description": "Learn IQX Studio: build web and Expo mobile apps with AI, work on the canvas, connect services, publish projects and manage credits.",
  "colors": {
    "primary": "#3456D8",
    "light": "#91A7FF",
    "dark": "#2946B5"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "dark": "#1e1e1e",
      "light": "#ffffff"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "favicon": "/images/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction",
              "quickstart",
              "studio",
              "prompting"
            ]
          },
          {
            "group": "Build your app",
            "pages": [
              "web-apps",
              "mobile-apps",
              "canvas",
              "agent-models"
            ]
          },
          {
            "group": "Bring your tools",
            "pages": [
              "import",
              "github-sync",
              "integrations",
              "figma",
              "mcp-and-ai-access"
            ]
          },
          {
            "group": "Data and services",
            "pages": [
              "services",
              "databases",
              "object-storage",
              "environment-variables"
            ]
          },
          {
            "group": "Publish and share",
            "pages": [
              "deployments",
              "custom-domains",
              "collaboration",
              "marketplace"
            ]
          },
          {
            "group": "Account and support",
            "pages": [
              "plans-and-credits",
              "usage-and-billing",
              "security",
              "troubleshooting"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "href": "https://iqx.dev/dashboard?view=community"
      },
      {
        "label": "Pricing",
        "href": "https://iqx.dev/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open IQX",
      "href": "https://iqx.dev/dashboard"
    }
  },
  "footer": {
    "socials": {
      "website": "https://iqx.dev",
      "github": "https://github.com/AiMG0D/iqx-docs",
      "x": "https://x.com/iqxide",
      "discord": "https://discord.com/invite/iqx"
    }
  },
  "logo": {
    "light": "/images/logo-light.png",
    "dark": "/images/logo-dark.png",
    "href": "/introduction"
  },
  "fonts": {
    "family": "Inter"
  },
  "search": {
    "prompt": "Search IQX guides..."
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "IQX Docs",
      "og:image": "https://docs.iqx.dev/images/social-card.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.iqx.dev/images/social-card.png"
    }
  }
}
